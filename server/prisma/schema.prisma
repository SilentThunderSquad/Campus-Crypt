generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  student
  alumni
  faculty
  admin
}

enum VerificationStatus {
  unverified
  verified
}

enum AuthProvider {
  google
}

enum RatingCategory {
  academics
  facilities
  campus_life
  value
}

model User {
  id                    String                @id @default(uuid())
  email                 String                @unique
  name                  String
  role                  UserRole              @default(student)
  verificationStatus    VerificationStatus    @default(unverified)
  provider              AuthProvider          @default(google)
  supabaseUserId        String?               @unique
  authMetadata          Json?
  lastLoginAt           DateTime?
  lastLoginIp           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  authIdentities        AuthIdentity[]
  sessions              Session[]
  communityMemberships  CommunityMembership[]
  profile               UserProfile?
  posts                 Post[]
  comments              Comment[]
  universityReviews     UniversityReview[]

  @@map("users")
}

model AuthIdentity {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       AuthProvider  @default(google)
  providerUserId String
  email          String?
  displayName    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([provider, providerUserId])
  @@map("auth_identities")
}

model Session {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash          String?
  userAgent          String?
  ipAddress          String?
  issuedAt           DateTime  @default(now())
  expiresAt          DateTime
  revokedAt          DateTime?
  replacedById       String?
  deviceFingerprint  String?
  authContext        Json?
  createdAt          DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())

  @@map("sessions")
}

model University {
  id          String                @id @default(uuid())
  name        String
  slug        String                @unique
  description String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  memberships CommunityMembership[]
  posts       Post[]
  comments    Comment[]
  reviews     UniversityReview[]
  ratings     UniversityRating[]

  @@map("universities")
}

model CommunityMembership {
  id          String    @id @default(uuid())
  userId      String
  universityId String
  joinedAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  university  University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([userId, universityId])
  @@map("community_memberships")
}

model UserProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String    @unique
  displayName String
  bio         String?
  avatarUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("user_profiles")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model Post {
  id           String      @id @default(uuid())
  universityId String
  authorId     String
  content      String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  university   University  @relation(fields: [universityId], references: [id], onDelete: Cascade)
  author       User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments     Comment[]

  @@index([universityId, createdAt])
  @@index([authorId])
  @@map("posts")
}

model Comment {
  id              String    @id @default(uuid())
  postId          String
  universityId    String
  authorId        String
  parentCommentId String?
  content         String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  post            Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  university      University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  author          User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentComment   Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[] @relation("CommentReplies")

  @@index([postId, createdAt])
  @@index([parentCommentId])
  @@index([universityId])
  @@map("comments")
}

model UniversityReview {
  id           String             @id @default(uuid())
  universityId String
  userId       String
  text         String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  university   University         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratings      UniversityRating[]

  @@unique([userId, universityId])
  @@index([universityId, createdAt])
  @@map("university_reviews")
}

model UniversityRating {
  id           String           @id @default(uuid())
  reviewId     String
  universityId String
  category     RatingCategory
  score        Int
  createdAt    DateTime         @default(now())
  review       UniversityReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  university   University       @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([reviewId, category])
  @@index([universityId, category])
  @@map("university_ratings")
}
