PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
SERVER_ORIGIN=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Supabase Auth / identity configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# Application database (Supabase PostgreSQL + Prisma)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Prisma CLI / migrations require the direct Supabase Postgres connection.
DIRECT_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require